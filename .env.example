# Development only. Generate independent values with: openssl rand -hex 32
# Use hex for KILN_DB_PASSWORD so it is safe inside the Compose database URL.
KILN_API_TOKEN=
# Optional separate credential for fake gateway setup and explicit monitor scans.
# Never distribute this value to routine CLI, MCP, SDK or dashboard clients.
KILN_INFRASTRUCTURE_TOKEN=
KILN_DB_PASSWORD=
# Opt-in gateway identity listeners. Files must be regular files, never symlinks.
# Private-key files must be mode 0600 or stricter. The gateway CA is distinct
# from the HTTPS server certificate and is used only to issue gateway client leaves.
KILN_TLS_CERT_FILE=
KILN_TLS_KEY_FILE=
KILN_GATEWAY_CA_CERT_FILE=
KILN_GATEWAY_CA_KEY_FILE=
KILN_GATEWAY_ENROLL_HOST=127.0.0.1
KILN_GATEWAY_ENROLL_PORT=4443
KILN_GATEWAY_HEARTBEAT_HOST=127.0.0.1
KILN_GATEWAY_HEARTBEAT_PORT=4444
KILN_PROBE_PROFILES_FILE=
# Optional Stage 2 lifecycle qualification. It is enabled only when this
# strict profile file is present, KILN_PROVIDER=proxmox-read-only, and callers
# present both the infrastructure bearer token and this distinct header token.
# Requires PostgreSQL; KILN_STORE=memory is rejected for real qualification.
KILN_PROXMOX_QUALIFICATION_FILE=
KILN_QUALIFICATION_TOKEN=
# Required when KILN_PROVIDER=proxmox-read-only. The qualification profile's
# tokenIdentity must match this token's identity.
KILN_PROXMOX_URL=
KILN_PROXMOX_TOKEN=
KILN_IMAGE_TRUSTED_KEYS_FILE=
# Guarded Linux development-image import. Keep the JSON profile and staging directory
# private to the appliance. The profile names the completed BIOS pool qualification.
KILN_PROXMOX_LINUX_IMPORT_FILE=
KILN_LINUX_IMAGE_STAGING_DIR=
KILN_LINUX_IMPORT_TOKEN=
