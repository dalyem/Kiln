#!/bin/sh
set -eu

systemctl is-active --quiet kiln-router-firewall.service
systemctl is-active --quiet kiln-router-lan.service
systemctl is-active --quiet dnsmasq.service
test "$$(systemctl is-enabled nftables.service)" = "masked"
test "$$(sysctl -n net.ipv4.ip_forward)" = "1"
test "$$(sysctl -n net.ipv6.conf.all.disable_ipv6)" = "1"

before=$$(mktemp)
after=$$(mktemp)
invalid=$$(mktemp)
trap 'rm -f "$$before" "$$after" "$$invalid"' EXIT
/usr/sbin/nft list table inet kiln_router >"$$before"
printf '%s\n' 'destroy table inet kiln_router' 'table inet kiln_router { invalid }' >"$$invalid"
if /usr/sbin/nft -c -f "$$invalid"; then
  echo "invalid nftables input unexpectedly passed" >&2
  exit 1
fi
/usr/sbin/nft list table inet kiln_router >"$$after"
cmp "$$before" "$$after"
