[Unit]
Description=Kiln outer lab router firewall
DefaultDependencies=no
Wants=network-pre.target systemd-sysctl.service
Before=network-pre.target
After=local-fs.target systemd-sysctl.service
OnFailure=kiln-router-fail-closed.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/kiln-router-load-firewall
ExecStartPost=/usr/sbin/sysctl -w net.ipv4.ip_forward=1
ExecStop=/usr/sbin/sysctl -w net.ipv4.ip_forward=0
RemainAfterExit=yes

[Install]
WantedBy=network-pre.target
